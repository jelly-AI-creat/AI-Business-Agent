# ---------------------------------------------------------------------------
# 复制本文件为 .env 后填写真实 Key（.env 不会被提交，本示例文件可以提交）
# ---------------------------------------------------------------------------
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_RETRIES=2
LLM_DRAFT_FILE=reply_drafts_llm.txt
LLM_TONE=formal